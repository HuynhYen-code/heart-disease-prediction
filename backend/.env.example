# ============================================================
# Backend Gateway – Environment Variables
# ============================================================
# Sao chép file này thành .env trước khi chạy:
#   cp .env.example .env      (macOS / Linux)
#   copy .env.example .env    (Windows)
# ============================================================

# Cổng lắng nghe của Node.js backend
PORT=5000

# URL của AI Service (FastAPI / Python)
# Mặc định chạy local trên cổng 8000
PYTHON_AI_SERVICE_URL=http://127.0.0.1:8000/predict
